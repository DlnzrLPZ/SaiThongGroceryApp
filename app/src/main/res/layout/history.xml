<?xml version="1.0" encoding="utf-8"?>
<!--
    history.xml: ประวัติกิจกรรม (แท็บย่อยในหน้ารายงาน ดู report_hub.xml)
    ตัวกรองประเภท + รายการจัดกลุ่มตามวัน ประวัติเก็บย้อนหลัง 3 เดือน
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- ตัวกรองประเภทกิจกรรม -->
    <HorizontalScrollView
        android:id="@+id/hsv_history_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_history_all"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/filter_history_sale"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_sale" />

            <TextView
                android:id="@+id/filter_history_add"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_add" />

            <TextView
                android:id="@+id/filter_history_update"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_update" />

            <TextView
                android:id="@+id/filter_history_delete"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_delete" />

            <TextView
                android:id="@+id/filter_history_alert"
                style="@style/HistoryFilterChip"
                android:text="@string/filter_alert" />
        </LinearLayout>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_history_filters" />

    <TextView
        android:id="@+id/tv_history_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/history_empty"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_history_filters" />

</androidx.constraintlayout.widget.ConstraintLayout>
