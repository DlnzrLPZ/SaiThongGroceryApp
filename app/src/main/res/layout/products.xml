<?xml version="1.0" encoding="utf-8"?>
<!--
    products.xml: หน้าจอแสดงรายการสินค้า (Product List)
    ประกอบด้วยส่วนค้นหา, การกรองหมวดหมู่ และรายการสินค้าทั้งหมดผ่าน RecyclerView
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- ส่วนที่ 1: ส่วนหัว (Header) และปุ่มเพิ่มสินค้า -->
    <RelativeLayout
        android:id="@+id/header_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/products_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- ปุ่มเพิ่มสินค้าใหม่ -->
        <LinearLayout
            android:id="@+id/btn_open_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_button_orange"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_add"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ส่วนที่ 2: ช่องค้นหา (Search Bar) -->
    <EditText
        android:id="@+id/et_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="20dp"
        android:autofillHints="name"
        android:background="@drawable/bg_rounded_white"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="12dp"
        android:hint="@string/search_hint"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/header_products" />

    <!-- ส่วนที่ 3: แท็บหมวดหมู่สินค้า (Category Tags) สำหรับกรองรายการ -->
    <HorizontalScrollView
        android:id="@+id/hsv_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/et_search">

        <LinearLayout
            android:id="@+id/container_tags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp">

            <TextView
                android:id="@+id/tag_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_orange"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_all"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tag_mama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_mama"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tag_drink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_drink"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tag_snack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_snack"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tag_milk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_milk"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tag_frozen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_rounded_white"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="@string/category_frozen"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ส่วนที่ 4: พื้นที่แสดงรายการสินค้าด้วย RecyclerView -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hsv_tags">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_products"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tv_products_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/products_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>