<?xml version="1.0" encoding="utf-8"?>
<!-- item_top_seller.xml: แถวสินค้าขายดี 1 อันดับในหน้ารายงานยอดขาย -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/tv_top_rank"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/bg_tag_orange"
        android:gravity="center"
        android:textColor="@color/brand_orange"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_top_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_top_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
