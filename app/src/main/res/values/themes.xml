<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SaiThongGroceryApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SaiThongGroceryApp" parent="Base.Theme.SaiThongGroceryApp" />

    <!-- Style ปุ่มตัวกรองในหน้าประวัติ (สถานะที่เลือกจะถูกเปลี่ยนสีใน History.kt) -->
    <style name="HistoryFilterChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_rounded_white</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Style สำหรับไอคอนสินค้า เพื่อให้เรียกใช้ง่ายและเหมือนกันทั้งแอป -->
    <style name="Widget.SaiThongGroceryApp.ProductIcon" parent="">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:padding">12dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>
